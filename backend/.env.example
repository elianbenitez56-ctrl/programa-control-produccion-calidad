# ===== SIGPC Backend - Variables de entorno =====
ENVIRONMENT=dev
DEBUG=false
API_V1_PREFIX=/api/v1

# Base de datos (opcional en modo demo)
# DATABASE_URL=postgresql+asyncpg://postgres:sigpc@localhost:5433/sigpc
SIGPC_SQLITE_PATH=sigpc-demo.db

# Usuario inicial (sobrescribir en producción)
SIGPC_ADMIN_USUARIO=admin
SIGPC_ADMIN_EMAIL=admin@sigpc.local
SIGPC_ADMIN_PASSWORD=Admin1234
SIGPC_SUPERVISOR_PASSWORD=Supervisor123

# Seguridad JWT
JWT_SECRET=cambiar-en-produccion
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7
RESET_TOKEN_EXPIRE_MINUTES=15

# CORS
CORS_ORIGINS=http://localhost:5173

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console

# Kiosko
KIOSK_HEADER=X-Kiosk-Id

# Rate limiting
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_LOGIN_PER_MINUTE=5

# URL base para enlaces de recuperacion (frontend)
FRONTEND_URL=http://localhost:5173
